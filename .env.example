# Telegram Bot Token - @BotFather se lena hai
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenRouter API Key - openrouter.ai se free account bana ke lena hai
OPENROUTER_API_KEY=your_openrouter_key_here

# Free model to use (change if you want a different one from the list)
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Gemini API key - PRIMARY AI source (OpenRouter ab use nahi ho raha, sirf Gemini + Groq backup)
# aistudio.google.com se free mein milta hai
# Multiple keys chahiye ho to comma se separate karo (alag Google accounts se banayi hui keys):
# GEMINI_API_KEY=key1,key2,key3
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq API key - Ek aur free fallback, alag independent quota (1000 req/day, super fast)
# console.groq.com se free mein milta hai, credit card nahi chahiye
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Manual DM payment flow - user /becomebf karega to sirf tera username dikhega DM karne ke liye
# Payment details tu khud privately batayega, verify karke /setbf <id> paid se activate karega
ADMIN_CONTACT_USERNAME=your_telegram_username

# MongoDB connection string - MongoDB Atlas free tier use karo
MONGODB_URI=your_mongodb_connection_string

# Daily message limit per user (free tier control)
DAILY_MSG_LIMIT=50

# Bot's name (waifu character name)
WAIFU_NAME=Miku

# Your channel/promo link (for the promotion/ads model)
PROMO_LINK=https://t.me/your_channel
PROMO_TEXT=Join our channel for updates!

# Comma-separated Telegram user IDs allowed to use /addsticker (your own ID)
# Apna ID pata karne ke liye Telegram pe @userinfobot ko message karo
ADMIN_IDS=your_telegram_id_here

# Owner ka naam (optional) - bot isse loyalty/respect context mein refer kar sakti hai
OWNER_NAME=your_name_here

# Group mein bina tag kiye bhi khud se reply kare (true/false)
GROUP_AUTO_REPLY=true

# Kitne % chance hai ki random message pe bhi bot kood jaye (0.05 = 5%)
GROUP_AUTO_REPLY_CHANCE=0.06

# Do autonomous replies ke beech minimum gap (seconds mein) - spam rokne ke liye
GROUP_AUTO_REPLY_COOLDOWN=180

# Voice messages - Sarvam AI (Bulbul v3) primary, Microsoft Edge TTS fallback
# Sarvam: Indian company, best Hinglish/Hindi voice quality, real fast API (no queue)
# Free: ₹1,000 signup credits (dashboard.sarvam.ai) - roughly 300K-600K characters
VOICE_ENABLED=true
# 'auto' (default, Sarvam try karo, fail ho to Edge pe fallback) | 'sarvam' (sirf Sarvam) | 'edge' (sirf Edge-TTS)
VOICE_PROVIDER=auto
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_LANG=hi-IN
SARVAM_TTS_SPEAKER=anushka

# Edge TTS fallback settings (unlimited free, kicks in agar Sarvam fail/khatam ho jaye)
EDGE_TTS_VOICE=hi-IN-SwaraNeural
# Har AI reply ke saath kitne % chance se text ki jagah voice note bheje (0.15 = 15%)
VOICE_REPLY_CHANCE=0.15
